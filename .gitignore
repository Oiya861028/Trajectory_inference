# ---- Large data (keep out of git; regenerate or re-download) ----
*.h5ad
*.loom
*.bam
*.bai
*.fastq
*.fastq.gz
*.mtx
*.mtx.gz
*.pkl

# Reference genomes / annotations and other downloaded external data
data/raw/external/

# Velocyto intermediates (barcode TSVs etc.)
data/interim/velocyto/

# ...but keep the small result tables
!results/tables/
!results/tables/**/*.csv

# ---- Logs & cluster output ----
logs/
*.out
*.err
slurm-*.out

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.ipynb_checkpoints
*.egg-info/
.venv/
venv/

# ---- Editor / OS ----
.DS_Store
.vscode/

# scvelo's default figdir, if a notebook ever forgets to set scv.settings.figdir.
# Anchored with a leading slash: an unanchored "figures/" would also match
# results/figures/, silently un-tracking every figure in the project.
/figures/
